# Copiar a .env.local. Obtener los valores de Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_... o service_role). Solo servidor: la usa la gestión de usuarios (/usuarios).
# Nunca con prefijo NEXT_PUBLIC_ ni en el frontend.
SUPABASE_SECRET_KEY=
# Secreto de Vercel Cron (cadena aleatoria larga). Vercel lo envía al llamar a /api/cron/keepalive
# (vercel.json), la tarea diaria que evita que Supabase pause el proyecto. Configurarlo en Vercel.
CRON_SECRET=
